# 中国旅游攻略 Agent · 环境变量配置
# 复制此文件为 .env，填入你的 API Key

# ─── Dify 模式 (推荐) ───
# Dify 服务地址 (虚拟机)
DIFY_BASE_URL=http://192.168.0.27/v1
# ★ 填你的 Dify API Key
DIFY_API_KEY=app-你的Dify_API_Key

# ─── 直连 LLM 模式 (备选) ───
# 使用 python main.py --direct 时用这个
TRAVEL_LLM_URL=http://127.0.0.1:15721/v1
TRAVEL_LLM_KEY=sk-no-key-needed
TRAVEL_LLM_MODEL=deepseek-v4-flash

# ─── 外部 API (可选) ───
# 高德地图 API Key
AMAP_KEY=
# Unsplash Access Key
UNSPLASH_KEY=
