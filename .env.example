# 中国旅游攻略 Agent · 环境变量配置
# 复制此文件为 .env，填入真实 Key（config.py 会自动读取；已存在的环境变量优先）

# ─── Dify 工作流模式 (默认) ───
DIFY_BASE_URL=http://192.168.0.11/v1
DIFY_INTENT_KEY=app-你的意图解析工作流Key
DIFY_ROUTE_KEY=app-你的路线规划工作流Key
DIFY_CONTENT_KEY=app-你的内容生成工作流Key

# ─── 直连 LLM 模式 (python main.py --direct) ───
TRAVEL_LLM_URL=http://127.0.0.1:15721/v1
TRAVEL_LLM_KEY=sk-no-key-needed
TRAVEL_LLM_MODEL=deepseek-v4-flash

# ─── 高德地图 (https://lbs.amap.com 控制台创建) ───
# Web服务 Key：天气 / POI搜索(坐标+实拍图) / 静态地图
AMAP_WEATHER_KEY=
# Web端(JS API) Key：前端地图
AMAP_JS_API_KEY=
# 安全密钥（与上面两个 Key 配对）
AMAP_SECRET=

# ─── Obsidian 知识库目录（留空则跳过保存）───
OBSIDIAN_KB_DIR=

# ─── 图片富化可选项 ───
# Wikimedia Commons 兜底图源开关在 config.py 的 ImageConfig.use_wikimedia
# （大陆访问不稳定，默认关闭；高德 POI 实拍图为主图源）
