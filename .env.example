# 中国旅游攻略 Agent · 环境变量配置
# 复制此文件为 .env，填入真实 Key（config.py 会自动读取；已存在的环境变量优先）

# ─── LangChain Agent 模型配置 ───
TRAVEL_LLM_URL=http://127.0.0.1:15721/v1
TRAVEL_LLM_KEY=sk-no-key-needed
TRAVEL_LLM_MODEL=deepseek-v4-flash
# 可选: 单次请求超时秒数、失败重试次数、最大输出 token 和结构化输出方式
TRAVEL_LLM_TIMEOUT=60
TRAVEL_LLM_MAX_RETRIES=1
TRAVEL_LLM_MAX_TOKENS=8192
# 温度可设为数字或 auto；auto 会省略温度参数
TRAVEL_LLM_TEMPERATURE=0.5
TRAVEL_LLM_PROVIDER=custom
TRAVEL_LLM_PROTOCOL=openai_compatible
TRAVEL_LLM_STRUCTURED_OUTPUT_METHOD=function_calling

# ─── DeepSeek Search / Fetch 网页资料（可选，默认仍关闭）───
# 留空时使用网页中保存的联网设置（默认关闭）。环境变量方式需显式开启并选择独立 Key 来源。
# 也可在网页“模型设置”里保存设置；独立 Search Key 不会自动复用 TRAVEL_LLM_KEY。
DEEPSEEK_SEARCH_ENABLED=
DEEPSEEK_SEARCH_AUTH_MODE=
DEEPSEEK_SEARCH_API_KEY=
# 默认 https://api.deepseek.com；环境变量代理地址必须配独立 Search Key。
DEEPSEEK_SEARCH_BASE_URL=

# ─── 高德地图 (https://lbs.amap.com 控制台创建) ───
# Web服务 Key：天气 / POI搜索(坐标+实拍图) / 静态地图。也兼容旧变量 AMAP_WEATHER_KEY。
AMAP_WEB_SERVICE_KEY=
# Web服务数字签名私钥，只用于服务端请求；也兼容 AMAP_REST_SECRET。
AMAP_WEB_SERVICE_SECRET=
# Web端(JS API) Key：浏览器加载地图
AMAP_JS_API_KEY=
# Web端(JS API) 安全码，与 AMAP_JS_API_KEY 配对。浏览器 SDK 会读取此值。
AMAP_JS_SECURITY_CODE=

# ─── Obsidian 知识库目录（留空则跳过保存）───
OBSIDIAN_KB_DIR=

# ─── 图片富化可选项 ───
# Wikimedia Commons 兜底图源开关在 config.py 的 ImageConfig.use_wikimedia
# （大陆访问不稳定，默认关闭；高德 POI 实拍图为主图源）
